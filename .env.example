# Copy to .env and fill in. Never commit .env.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REMINDER_DAYS=
DB_PATH=
#DB_PATH=dev.db

# Database. Set BOTH Turso values to use the live database; leave BOTH blank to use the
# local SQLite file at DB_PATH (tests and fake dev data). Setting only one is an error.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=